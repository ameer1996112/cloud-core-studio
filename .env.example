SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-staging-or-test-service-role-key"

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# Public app download links. Set APP_STORE_URL in Cloud Run before promoting
# /download publicly; GOOGLE_PLAY_URL may stay empty until Android is live.
APP_STORE_URL="https://apps.apple.com/il/app/cloud-core/id6786035836"
GOOGLE_PLAY_URL=""

# HYP Pay hosted payment page integration. Server-only; never expose as VITE_*.
HYP_PAY_BASE_URL="https://pay.hyp.co.il/p/"
# Optional HYP XML API endpoint used by transaction inquiry reconciliation.
HYP_RELAY_URL="https://your-hyp-environment-url/xpo/Relay"
HYP_MODE="test"
HYP_PUBLIC_BASE_URL="https://cloudandcorestudio.com"

# EZcount legal receipt delivery. Server-only; never expose as VITE_*.
# Enable only after disabling HYP/EZcount terminal-side automatic issuance.
EZCOUNT_API_KEY="your-ezcount-api-key"
EZCOUNT_DEVELOPER_EMAIL="cloudandcorestudio@gmail.com"
EZCOUNT_API_URL="https://api.ezcount.co.il/api/createDoc"
EZCOUNT_RECEIPTS_ENABLED="false"

# Live HYP Pay credentials.
HYP_API_USER="your-hyp-api-user-or-api-key"
HYP_API_PASSWORD="your-hyp-api-password-or-passp"
HYP_TERMINAL_NUMBER="your-hyp-masof-terminal-number"

# Test HYP Pay credentials. Test terminal numbers start with 00100.
HYP_TEST_API_USER="your-hyp-test-api-user-or-api-key"
HYP_TEST_API_PASSWORD="your-hyp-test-api-password-or-passp"
HYP_TEST_TERMINAL_NUMBER="00100..."

# Server-side business email alert for confirmed HYP card payments.
# Resend requires the sender domain to be verified before using a custom from address.
RESEND_API_KEY="re_..."
PAYMENT_NOTIFICATION_EMAIL="cloudandcorestudio@gmail.com"
PAYMENT_NOTIFICATION_FROM="Cloud & Core Studio <payments@cloudandcorestudio.com>"

# Mutating E2E guardrails. Never enable these against production.
APP_ENV="development"
ALLOW_E2E_MUTATION="false"

# Optional WhatsApp automation control-plane token.
# Server-only. This authorizes the Mac worker to claim/report queued notification jobs.
OPENWA_AUTOMATION_TOKEN="your-shared-worker-token"

# Official Meta WhatsApp Cloud API. Server-only; never expose as VITE_*.
WHATSAPP_NOTIFICATION_PROVIDER="official_whatsapp"
META_GRAPH_API_VERSION="v25.0"
META_WABA_ID="your-whatsapp-business-account-id"
META_WHATSAPP_PHONE_NUMBER_ID="your-cloud-api-phone-number-id"
META_ACCESS_TOKEN="your-permanent-system-user-access-token"
# Private uploaded IMAGE-header handle. Use this environment value or --header-handle-stdin;
# never pass the handle itself in argv.
META_TEMPLATE_IMAGE_HEADER_HANDLE=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-meta-webhook-verify-token"
WHATSAPP_APP_SECRET="your-meta-app-secret"
NOTIFICATION_AUTOMATION_TOKEN="your-shared-internal-notification-token"

# Unified transactional messaging. The scheduler and every external channel are off by default.
MESSAGING_SCHEDULER_ENABLED="false"
MESSAGING_IMMEDIATE_DISPATCH_ENABLED="false"
# HTTPS URL for the same deployment's protected canonical sweep endpoint.
MESSAGING_INTERNAL_SWEEP_URL="https://cloudandcorestudio.com/api/internal/messages/sweep"
MESSAGING_CANONICAL_READS_ENABLED="false"
MESSAGING_DELIVERY_MODE="disabled"
MESSAGING_RECIPIENT_ALLOWLIST=""
MESSAGING_WHATSAPP_ENABLED="false"
MESSAGING_EMAIL_ENABLED="false"
MESSAGING_PUSH_ENABLED="false"
# Required only for live mode; must exactly match the confirmed Cloud & Core WABA.
MESSAGING_LIVE_WABA_CONFIRMATION=""
RESEND_API_KEY="re_..."
# Use a stable human sender on the exact Resend-verified transactional subdomain.
MESSAGING_EMAIL_FROM="Cloud & Core Studio <studio@mail.cloudandcorestudio.com>"
MESSAGING_EMAIL_REPLY_TO="cloudandcorestudio@gmail.com"
MESSAGING_PUBLIC_BASE_URL="https://cloudandcorestudio.com"
RESEND_WEBHOOK_SECRET="whsec_..."

# Legacy delivery workers remain available only for non-destructive rollback.
OPENWA_LEGACY_DELIVERY_ENABLED="false"
OFFICIAL_WHATSAPP_LEGACY_DELIVERY_ENABLED="false"
LEGACY_MEMBER_NOTIFICATION_DELIVERY_ENABLED="false"

# Native iPhone admin push notifications through Apple APNs.
# Server-only; APNS_PRIVATE_KEY is the .p8 key content with newlines escaped as \n.
APNS_ENV="production"
# Build-time iOS registration metadata; use sandbox only for development-signed builds.
VITE_APNS_ENV="production"
APNS_KEY_ID="your-apple-key-id"
APNS_TEAM_ID="your-apple-team-id"
APNS_BUNDLE_ID="com.cloudandcore.studio"
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional Mac-local WhatsApp worker settings.
# These belong on the studio Mac worker, not in VITE_* and not in the App Store app.
CLOUD_CORE_BASE_URL="https://your-cloud-run-or-domain.example.com"
OPENWA_LOCAL_BASE_URL="http://localhost:2785"
OPENWA_API_KEY="your-openwa-api-key"
# This is the generated OpenWA session id. Update it on the Mac if OpenWA creates a new session.
OPENWA_SESSION_ID="your-openwa-session-id"
OPENWA_WORKER_ID="studio-mac"
OPENWA_TEST_PHONE="+972501234567"
