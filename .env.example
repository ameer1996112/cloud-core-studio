SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-staging-or-test-service-role-key"

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# Mutating E2E guardrails. Never enable these against production.
APP_ENV="development"
ALLOW_E2E_MUTATION="false"

# Optional server-only WhatsApp automation via self-hosted OpenWA.
# Keep these out of VITE_* so they never ship to the browser.
OPENWA_BASE_URL="http://localhost:2785"
OPENWA_API_KEY="your-openwa-api-key"
# This is the generated OpenWA session id, not the session display name.
OPENWA_SESSION_ID="your-openwa-session-id"
