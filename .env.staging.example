# Copy this file to .env.staging and replace every your-* placeholder.
# Never put secret values in this file. It contains resource names and public values only.
APP_ENV="staging"
ALLOW_E2E_MUTATION="false"

# Dedicated staging infrastructure. The deploy guard rejects the production service.
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="me-west1"
CLOUD_RUN_SERVICE="cloud-core-studio-staging"
STAGING_SERVICE_ACCOUNT="manychat-v3-staging@your-gcp-project-id.iam.gserviceaccount.com"
STAGING_IMAGE="me-west1-docker.pkg.dev/your-gcp-project-id/your-staging-repository/cloud-core-studio-staging"

# Public values from a distinct, empty/test-only staging Supabase project.
SUPABASE_PROJECT_ID="your-distinct-staging-project-ref"
SUPABASE_URL="https://your-distinct-staging-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-staging-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-distinct-staging-project-ref"
VITE_SUPABASE_URL="https://your-distinct-staging-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-staging-publishable-key"

# Secret Manager resource names only. Store values in Secret Manager, never here.
SUPABASE_SERVICE_ROLE_SECRET="manychat-v3-staging-supabase-service-role"
MANYCHAT_BEARER_SECRET="manychat-v3-staging-bearer"
TEST_NOTIFICATION_CONFIG_SECRET="manychat-v3-staging-test-notification-config"

# Stage 1 is intentionally inert. Activation is outside this staging-setup change.
MANYCHAT_V3_ENABLED="false"
MANYCHAT_V3_OUTBOUND_ENABLED="false"
MESSAGING_SCHEDULER_ENABLED="false"
MESSAGING_IMMEDIATE_DISPATCH_ENABLED="false"
MESSAGING_CANONICAL_READS_ENABLED="false"
MESSAGING_DELIVERY_MODE="disabled"
MESSAGING_RECIPIENT_ALLOWLIST=""
MESSAGING_WHATSAPP_ENABLED="false"
MESSAGING_EMAIL_ENABLED="false"
MESSAGING_PUSH_ENABLED="false"
OPENWA_LEGACY_DELIVERY_ENABLED="false"
OFFICIAL_WHATSAPP_LEGACY_DELIVERY_ENABLED="false"
LEGACY_MEMBER_NOTIFICATION_DELIVERY_ENABLED="false"
APNS_ENV="sandbox"
VITE_APNS_ENV="sandbox"
